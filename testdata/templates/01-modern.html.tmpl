{{ define "extractedFilesRows" }}
{{ $files := index . 0 }}
{{ $depth := index . 1 }}
{{ range $file := $files }}
<tr>
    <td class="name" style="padding-left: {{ add 8 (mul (min $depth 6) 14) }}px">{{ if gt $depth 0 }}<span class="tree">└</span>{{ end }}{{ .Name }}</td>
    <td class="threats">{{ range .Malwares }}<span class="pill pill-danger">{{ . }}</span>{{ end }}</td>
    <td><code class="hash">{{ .SHA256 }}</code></td>
    <td class="num">{{ .Size }}</td>
    <td>{{ .MitigationReason }}</td>
    <td>{{ if eq .GMalwareURL "" }}<span class="muted">—</span>{{ else }}<a href="{{ .GMalwareURL }}">Ouvrir&nbsp;↗</a>{{ end }}</td>
</tr>
{{ if gt (len .ExtractedFiles) 0 }}
{{ template "extractedFilesRows" (mergeArgsIntoSlice .ExtractedFiles (add $depth 1)) }}
{{ end }}
{{ end }}
{{ end }}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Rapport d'analyse — {{ .ScanID }}</title>
<style>
    :root {
        --ink: #1b1f24;
        --ink-soft: #57606a;
        --line: #d8dee4;
        --surface: #f6f8fa;
        --accent: #ea5b0c;
        --accent-2: #f9c105;
        --danger: #cf222e;
        --danger-bg: #ffebe9;
        --ok: #1a7f37;
        --ok-bg: #dafbe1;
        --warn: #9a6700;
        --warn-bg: #fff8c5;
        --radius: 6px;
    }

    @page {
        size: A4;
        margin: 22mm 14mm 20mm;

        @top-left {
            content: string(scan-id);
            font: 8pt/1 "DejaVu Sans", Arial, sans-serif;
            color: #57606a;
        }
        @top-right {
            content: string(section);
            font: 8pt/1 "DejaVu Sans", Arial, sans-serif;
            color: #57606a;
        }
        @bottom-left {
            content: "TLP:AMBER";
            font: bold 8pt/1 "DejaVu Sans", Arial, sans-serif;
            color: #a36f00;
            letter-spacing: 0.08em;
        }
        @bottom-right {
            content: "Page " counter(page) " / " counter(pages);
            font: 8pt/1 "DejaVu Sans", Arial, sans-serif;
            color: #57606a;
        }
    }

    @page :first {
        @top-left { content: none; }
        @top-right { content: none; }
    }

    * { box-sizing: border-box; }

    html {
        font: 9.5pt/1.5 "DejaVu Sans", "Segoe UI", Arial, sans-serif;
        color: var(--ink);
    }

    body { margin: 0; }

    .cover {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12mm;
        padding: 8mm 10mm;
        border-radius: var(--radius);
        background: linear-gradient(120deg, #e52321 0%, var(--accent) 45%, var(--accent-2) 100%);
        color: #fff;
    }

    .cover h1 {
        margin: 0;
        font-size: 20pt;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .cover .scan-id {
        string-set: scan-id "Scan " content();
        margin: 2mm 0 0;
        font-family: "DejaVu Sans Mono", monospace;
        font-size: 9pt;
        opacity: 0.9;
    }

    .cover .verdict {
        flex: none;
        padding: 3mm 5mm;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.95);
        font-weight: 700;
        font-size: 10pt;
        white-space: nowrap;
    }

    .verdict.bad { color: var(--danger); }
    .verdict.good { color: var(--ok); }

    .kpis {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4mm;
        margin: 6mm 0;
    }

    .kpi {
        padding: 3mm 4mm;
        border: 1px solid var(--line);
        border-top: 3px solid var(--accent);
        border-radius: var(--radius);
        background: var(--surface);
        break-inside: avoid;
    }

    .kpi .value {
        display: block;
        font-size: 16pt;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .kpi .label {
        font-size: 8pt;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .kpi.danger { border-top-color: var(--danger); }
    .kpi.danger .value { color: var(--danger); }
    .kpi.warn { border-top-color: var(--warn); }

    section { margin-top: 8mm; }

    h2 {
        string-set: section content();
        margin: 0 0 3mm;
        padding-bottom: 1.5mm;
        font-size: 13pt;
        color: var(--accent);
        border-bottom: 1.5pt solid var(--accent);
        break-after: avoid;
    }

    h3 {
        margin: 5mm 0 2mm;
        font-size: 11pt;
        break-after: avoid;
    }

    dl.facts {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 1mm 6mm;
        margin: 0;
    }

    dl.facts dt { color: var(--ink-soft); }
    dl.facts dd { margin: 0; font-variant-numeric: tabular-nums; }

    .callout {
        margin: 3mm 0;
        padding: 3mm 4mm;
        border-left: 4px solid var(--warn);
        border-radius: 0 var(--radius) var(--radius) 0;
        background: var(--warn-bg);
        break-inside: avoid;
    }

    .callout.danger { border-left-color: var(--danger); background: var(--danger-bg); }
    .callout.ok { border-left-color: var(--ok); background: var(--ok-bg); }
    .callout p { margin: 0; }
    .callout p + p { margin-top: 1.5mm; }

    table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 8pt;
        line-height: 1.3;
    }

    thead { display: table-header-group; }

    th {
        padding: 2mm;
        text-align: left;
        font-weight: 600;
        color: #fff;
        background: var(--ink);
    }

    th:first-child { border-top-left-radius: var(--radius); }
    th:last-child { border-top-right-radius: var(--radius); }

    td {
        padding: 1.6mm 2mm;
        vertical-align: top;
        border-bottom: 0.5pt solid var(--line);
        overflow-wrap: anywhere;
    }

    tbody tr:nth-child(even) td { background: var(--surface); }
    tr { break-inside: avoid; }

    td.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    td.name { font-weight: 500; }
    .tree { color: var(--ink-soft); margin-right: 1.5mm; }

    code.hash {
        font: 7pt/1.3 "DejaVu Sans Mono", monospace;
        color: var(--ink-soft);
        word-break: break-all;
    }

    .pill {
        display: inline-block;
        margin: 0 1mm 1mm 0;
        padding: 0.3mm 2mm;
        border-radius: 999px;
        font-size: 7pt;
        font-weight: 600;
        white-space: nowrap;
    }

    .pill-danger { color: var(--danger); background: var(--danger-bg); }

    a { color: var(--accent); text-decoration: none; }
    .muted { color: var(--ink-soft); }
    .more { margin: 2mm 0 0; font-style: italic; color: var(--ink-soft); }

    .archive {
        margin-top: 5mm;
        padding: 4mm;
        border: 1px solid var(--line);
        border-radius: var(--radius);
    }

    .archive h3 { margin-top: 0; }
    .archive dl.facts { margin-bottom: 3mm; font-size: 8.5pt; }

    col.c-name { width: 26%; }
    col.c-threat { width: 18%; }
    col.c-hash { width: 24%; }
    col.c-size { width: 9%; }
    col.c-reason { width: 13%; }
    col.c-link { width: 10%; }
</style>
</head>
<body>

<header class="cover">
    <div>
        <h1>Rapport d'analyse</h1>
        <p class="scan-id">{{ .ScanID }}</p>
    </div>
    {{ if gt .TotalMitigated 0 }}
    <div class="verdict bad">● {{ .TotalMitigated }} fichier(s) bloqué(s)</div>
    {{ else }}
    <div class="verdict good">✓ Aucune menace</div>
    {{ end }}
</header>

<div class="kpis">
    <div class="kpi"><span class="value">{{ .NbFileSubmitted }}</span><span class="label">Fichiers listés</span></div>
    <div class="kpi"><span class="value">{{ .NbFileAnalyzed }}</span><span class="label">Analysés</span></div>
    <div class="kpi danger"><span class="value">{{ .TotalMitigated }}</span><span class="label">Bloqués</span></div>
    <div class="kpi warn"><span class="value">{{ .NbFileNotAnalyzed }}</span><span class="label">Non analysés</span></div>
</div>

<section id="analysis-details">
    <h2>Détails de l'analyse</h2>
    <dl class="facts">
        <dt>Taille totale (avant extraction)</dt><dd>{{ .FileVolume }}</dd>
        <dt>Volume analysé</dt><dd>{{ .AnalyzedVolume }}</dd>
        <dt>Volume filtré</dt><dd>{{ .FilteredVolume }}</dd>
        <dt>Bloqués</dt><dd>{{ .TotalMitigated }}, dont {{ .TotalMalware }} détectés comme malveillants</dd>
        <dt>Fichiers en erreur</dt><dd>{{ .TotalErrors }}</dd>
        <dt>Début</dt><dd>{{ .ScanStartTime }}</dd>
        <dt>Durée</dt><dd>{{ .Duration }}</dd>
    </dl>
</section>

<section id="conclusion">
    <h2>Conclusion</h2>
    {{ if gt .TotalMitigated 0 }}
    <div class="callout danger">
        <p><strong>Un ou plusieurs fichiers ont été bloqués par les moteurs d'analyse.</strong></p>
        <p>Seuls les fichiers analysés comme sains ont été déplacés sur le support de destination.</p>
    </div>
    {{ else }}
    <div class="callout ok">
        <p><strong>Aucun comportement suspect ou malveillant n'a été détecté.</strong></p>
        <p>Seuls les fichiers analysés comme sains ont été déplacés sur le support de destination.</p>
    </div>
    {{ end }}
    {{ if gt .NbFileNotAnalyzed 0 }}
    <div class="callout">
        <p>Des fichiers non analysés ont pu être transmis sans analyse complète, selon la politique <code>unanalyzable_policy</code> : leur contenu n'a pas été vérifié.</p>
    </div>
    {{ end }}
</section>

{{ if gt (len .MitigatedFiles) 0 }}
<section id="threat-files">
    <h2>Fichiers bloqués</h2>
    <table>
        <colgroup><col class="c-name"><col class="c-threat"><col class="c-hash"><col class="c-size"><col class="c-reason"><col class="c-link"></colgroup>
        <thead><tr><th>Chemin</th><th>Menaces</th><th>SHA-256</th><th>Taille</th><th>Raison</th><th>Analyse</th></tr></thead>
        <tbody>
        {{ range .MitigatedFiles }}
        <tr>
            <td class="name">{{ .Name }}</td>
            <td class="threats">{{ range .Malwares }}<span class="pill pill-danger">{{ . }}</span>{{ end }}</td>
            <td><code class="hash">{{ .SHA256 }}</code></td>
            <td class="num">{{ .Size }}</td>
            <td>{{ .MitigationReason }}</td>
            <td>{{ if eq .GMalwareURL "" }}<span class="muted">—</span>{{ else }}<a href="{{ .GMalwareURL }}">Ouvrir&nbsp;↗</a>{{ end }}</td>
        </tr>
        {{ end }}
        </tbody>
    </table>
    {{ if gt .MoreMitigatedFiles 0 }}<p class="more">… et {{ others .MoreMitigatedFiles "" "" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt (len .MitigatedArchives) 0 }}
<section id="threat-archive">
    <h2>Archives bloquées</h2>
    {{ range $index, $a := .MitigatedArchives }}
    <article class="archive" id="threat-archive-{{ $index }}">
        <h3>{{ .Name }}</h3>
        <dl class="facts">
            <dt>Sous-fichiers extraits</dt><dd>{{ .FileCount }}</dd>
            <dt>SHA-256</dt><dd><code class="hash">{{ .SHA256 }}</code></dd>
            <dt>Taille</dt><dd>{{ .Size }}</dd>
            <dt>Quarantaine</dt><dd><code class="hash">{{ .QuarantineLocation }}</code></dd>
        </dl>
        <table>
            <colgroup><col class="c-name"><col class="c-threat"><col class="c-hash"><col class="c-size"><col class="c-reason"><col class="c-link"></colgroup>
            <thead><tr><th>Nom</th><th>Menaces</th><th>SHA-256</th><th>Taille</th><th>Raison</th><th>Analyse</th></tr></thead>
            <tbody>
            {{ template "extractedFilesRows" (mergeArgsIntoSlice .ExtractedFiles 0) }}
            </tbody>
        </table>
        {{ if gt .MoreExtracted 0 }}<p class="more">… et {{ others .MoreExtracted " fichier de l'archive" " fichiers de l'archive" }}</p>{{ end }}
    </article>
    {{ end }}
    {{ if gt .MoreMitigatedArchives 0 }}<p class="more">… et {{ others .MoreMitigatedArchives " archive" " archives" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt .NbFileNotAnalyzed 0 }}
<section id="not-analyzed-files">
    <h2>Fichiers non analysés</h2>
    <p>Ces fichiers n'ont pas été analysés complètement : leur contenu n'a pas été vérifié. Total : {{ .NbFileNotAnalyzed }}.</p>
    <table>
        <thead><tr><th>Fichier</th><th style="width:14%">Taille</th><th>Raison</th><th>Archive d'origine</th></tr></thead>
        <tbody>
        {{ range .NotAnalyzedFiles }}
        <tr><td class="name">{{ .Name }}</td><td class="num">{{ .Size }}</td><td>{{ .Reason }}</td><td>{{ if .Origin }}{{ .Origin }}{{ else }}<span class="muted">—</span>{{ end }}</td></tr>
        {{ end }}
        </tbody>
    </table>
    {{ if gt .MoreNotAnalyzed 0 }}<p class="more">… et {{ others .MoreNotAnalyzed "" "" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt (len .ErrorFiles) 0 }}
<section id="error-files">
    <h2>Fichiers en erreur</h2>
    <table>
        <thead><tr><th style="width:40%">Fichier</th><th>Erreur</th></tr></thead>
        <tbody>
        {{ range .ErrorFiles }}
        <tr><td class="name">{{ .Name }}</td><td><code class="hash">{{ .Error }}</code></td></tr>
        {{ end }}
        </tbody>
    </table>
    {{ if gt .MoreErrorFiles 0 }}<p class="more">… et {{ others .MoreErrorFiles "" "" }}</p>{{ end }}
</section>
{{ end }}

</body>
</html>
