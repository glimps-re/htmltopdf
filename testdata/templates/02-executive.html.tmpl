{{ define "extractedFilesRows" }}
{{ $files := index . 0 }}
{{ $depth := index . 1 }}
{{ range $file := $files }}
<li class="finding depth-{{ min $depth 6 }}" style="margin-left: {{ mul (min $depth 6) 6 }}mm">
    <div class="finding-head">
        <span class="finding-name">{{ .Name }}</span>
        <span class="finding-size">{{ .Size }}</span>
    </div>
    <div class="finding-body">
        <span class="threats">{{ range .Malwares }}<span class="tag">{{ . }}</span>{{ end }}</span>
        <span class="reason">{{ .MitigationReason }}</span>
        {{ if ne .GMalwareURL "" }}<a class="link" href="{{ .GMalwareURL }}">Analyse détaillée</a>{{ end }}
    </div>
    <code class="sha">{{ .SHA256 }}</code>
</li>
{{ if gt (len .ExtractedFiles) 0 }}
{{ template "extractedFilesRows" (mergeArgsIntoSlice .ExtractedFiles (add $depth 1)) }}
{{ end }}
{{ end }}
{{ end }}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Synthèse d'analyse — {{ .ScanID }}</title>
<style>
    @page {
        size: A4;
        margin: 25mm 20mm 22mm;

        @top-center {
            content: "Synthèse d'analyse";
            font: italic 8pt "DejaVu Serif", Georgia, serif;
            color: #8a8f98;
            border-bottom: 0.5pt solid #d0d4da;
            width: 100%;
            vertical-align: bottom;
            padding-bottom: 2mm;
        }
        @bottom-left {
            content: "TLP:AMBER";
            font: bold 7.5pt "DejaVu Sans", Arial, sans-serif;
            color: #a36f00;
            letter-spacing: 0.08em;
        }
        @bottom-right {
            content: counter(page) " / " counter(pages);
            font: 8pt "DejaVu Sans", Arial, sans-serif;
            color: #8a8f98;
        }
    }

    @page cover {
        margin: 0;
        @top-center { content: none; border: none; }
        @bottom-left { content: none; }
        @bottom-right { content: none; }
    }

    :root {
        --navy: #14213d;
        --accent: #ea5b0c;
        --gold: #f9c105;
        --red: #c0392b;
        --green: #2e7d32;
        --amber: #b7791f;
        --grey: #8a8f98;
        --line: #e3e6ea;
    }

    html {
        font: 10pt/1.55 "DejaVu Serif", Georgia, serif;
        color: #22262e;
    }

    body {
        margin: 0;
        counter-reset: chapter;
    }

    h1, h2, h3, .sans {
        font-family: "DejaVu Sans", "Segoe UI", Arial, sans-serif;
    }

    .cover {
        page: cover;
        break-after: page;
        position: relative;
        box-sizing: border-box;
        height: 296mm;
        padding: 40mm 25mm 0;
        color: #fff;
        background: var(--navy);
        overflow: hidden;
    }

    .cover::after {
        content: "";
        position: absolute;
        right: -60mm;
        bottom: -60mm;
        width: 180mm;
        height: 180mm;
        border-radius: 50%;
        background: radial-gradient(circle, var(--accent) 0%, rgba(234, 91, 12, 0) 70%);
        opacity: 0.55;
    }

    .cover .logo { width: 22mm; height: 22mm; }

    .cover .kicker {
        margin: 18mm 0 4mm;
        font: 600 10pt "DejaVu Sans", Arial, sans-serif;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--gold);
    }

    .cover h1 {
        margin: 0;
        font-size: 30pt;
        line-height: 1.15;
        font-weight: 700;
    }

    .cover .meta {
        margin-top: 12mm;
        font: 9.5pt/1.8 "DejaVu Sans", Arial, sans-serif;
        color: #c9d1e0;
    }

    .cover .meta code { color: #fff; font-family: "DejaVu Sans Mono", monospace; }

    .cover .stamp {
        position: absolute;
        left: 25mm;
        bottom: 30mm;
        z-index: 1;
        padding: 4mm 7mm;
        border: 2pt solid currentColor;
        border-radius: 3mm;
        font: 700 14pt "DejaVu Sans", Arial, sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        transform: rotate(-4deg);
    }

    .stamp.bad { color: #ff6b5b; }
    .stamp.good { color: #7ddc8a; }

    nav.toc { break-after: page; }

    nav.toc h2 { counter-increment: none; }
    nav.toc h2::before { content: none; }

    nav.toc ol {
        list-style: none;
        margin: 0;
        padding: 0;
        font-family: "DejaVu Sans", Arial, sans-serif;
    }

    nav.toc li { margin: 2mm 0; }

    nav.toc a {
        color: inherit;
        text-decoration: none;
    }

    nav.toc a::after {
        content: leader(".") target-counter(attr(href), page);
        color: var(--grey);
    }

    h2 {
        counter-increment: chapter;
        margin: 0 0 5mm;
        font-size: 16pt;
        color: var(--navy);
        break-after: avoid;
    }

    h2::before {
        content: counter(chapter, decimal-leading-zero) "  ";
        color: var(--accent);
    }

    section + section { margin-top: 12mm; }

    .lead { font-size: 11.5pt; }

    .breakdown {
        display: flex;
        height: 7mm;
        margin: 6mm 0 2mm;
        border-radius: 3.5mm;
        overflow: hidden;
    }

    .breakdown span { min-width: 1.5mm; }
    .breakdown .s-ok { background: var(--green); }
    .breakdown .s-bad { background: var(--red); }
    .breakdown .s-na { background: var(--amber); }
    .breakdown .s-err { background: var(--grey); }

    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 2mm 7mm;
        margin: 0 0 6mm;
        padding: 0;
        list-style: none;
        font: 8.5pt "DejaVu Sans", Arial, sans-serif;
    }

    .legend li::before {
        content: "";
        display: inline-block;
        width: 3mm;
        height: 3mm;
        margin-right: 1.5mm;
        border-radius: 50%;
        vertical-align: -0.3mm;
        background: var(--c);
    }

    table.facts {
        width: 100%;
        border-collapse: collapse;
        font: 9pt "DejaVu Sans", Arial, sans-serif;
    }

    table.facts th, table.facts td {
        padding: 2mm 0;
        border-bottom: 0.5pt solid var(--line);
        text-align: left;
    }

    table.facts th { width: 45%; font-weight: normal; color: var(--grey); }
    table.facts td { text-align: right; font-weight: 600; }

    blockquote {
        margin: 6mm 0;
        padding: 4mm 6mm;
        border-left: 3pt solid var(--accent);
        background: #fbf7f4;
        font-style: italic;
    }

    blockquote p { margin: 0; }
    blockquote p + p { margin-top: 2mm; }

    ol.findings {
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: finding;
    }

    .finding {
        position: relative;
        margin-bottom: 3mm;
        padding: 3mm 4mm 3mm 11mm;
        border: 0.5pt solid var(--line);
        border-left: 2.5pt solid var(--red);
        border-radius: 1.5mm;
        break-inside: avoid;
        counter-increment: finding;
        font-family: "DejaVu Sans", Arial, sans-serif;
        font-size: 8.5pt;
    }

    .finding::before {
        content: counter(finding);
        position: absolute;
        left: 3mm;
        top: 3mm;
        width: 5.5mm;
        height: 5.5mm;
        border-radius: 50%;
        background: var(--red);
        color: #fff;
        font-size: 7pt;
        font-weight: 700;
        line-height: 5.5mm;
        text-align: center;
    }

    .finding.depth-1, .finding.depth-2, .finding.depth-3,
    .finding.depth-4, .finding.depth-5, .finding.depth-6 {
        border-left-color: var(--amber);
    }

    .finding-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 4mm;
    }

    .finding-name { font-weight: 700; overflow-wrap: anywhere; }
    .finding-size { flex: none; color: var(--grey); }

    .finding-body {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5mm 4mm;
        margin: 1.5mm 0;
    }

    .tag {
        display: inline-block;
        margin-right: 1.5mm;
        padding: 0.2mm 1.8mm;
        border: 0.5pt solid var(--red);
        border-radius: 1mm;
        color: var(--red);
        font-size: 7.5pt;
    }

    .reason { color: #444; }
    .link { margin-left: auto; color: var(--accent); }

    code.sha {
        display: block;
        font: 7pt "DejaVu Sans Mono", monospace;
        color: var(--grey);
        word-break: break-all;
    }

    .archive-card {
        margin: 6mm 0;
        break-inside: avoid-page;
    }

    .archive-card h3 {
        display: flex;
        align-items: center;
        gap: 3mm;
        margin: 0 0 2mm;
        font-size: 11pt;
    }

    .archive-card h3 svg { width: 5mm; height: 5mm; flex: none; }

    .archive-meta {
        margin: 0 0 3mm;
        font: 8pt "DejaVu Sans", Arial, sans-serif;
        color: var(--grey);
    }

    .more { font-style: italic; color: var(--grey); }

    table.simple {
        width: 100%;
        border-collapse: collapse;
        font: 8.5pt "DejaVu Sans", Arial, sans-serif;
    }

    table.simple thead { display: table-header-group; }

    table.simple th {
        padding: 2mm;
        text-align: left;
        font-size: 7.5pt;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--grey);
        border-bottom: 1pt solid var(--navy);
    }

    table.simple td {
        padding: 2mm;
        border-bottom: 0.5pt solid var(--line);
        vertical-align: top;
        overflow-wrap: anywhere;
    }
</style>
</head>
<body>

<section class="cover">
    <svg class="logo" viewBox="0 0 24 24" fill="none" stroke="#f9c105" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2 3.5 5.5v6.2c0 5 3.6 9.1 8.5 10.3 4.9-1.2 8.5-5.3 8.5-10.3V5.5L12 2Z"/>
        <path d="m8.2 12.2 2.6 2.6 5-5.2"/>
    </svg>
    <p class="kicker">Synthèse d'analyse</p>
    <h1>Contrôle des fichiers<br>soumis à l'analyse</h1>
    <div class="meta">
        Identifiant&nbsp;: <code>{{ .ScanID }}</code><br>
        Début&nbsp;: {{ .ScanStartTime }} · Durée&nbsp;: {{ .Duration }}<br>
        Volume&nbsp;: {{ .FileVolume }}
    </div>
    {{ if gt .TotalMitigated 0 }}
    <div class="stamp bad">{{ .TotalMitigated }} menace(s) bloquée(s)</div>
    {{ else }}
    <div class="stamp good">Aucune menace</div>
    {{ end }}
</section>

<nav class="toc">
    <h2>Sommaire</h2>
    <ol>
        <li><a href="#summary">Résumé</a></li>
        {{ if gt (len .MitigatedFiles) 0 }}<li><a href="#threat-files">Fichiers bloqués</a></li>{{ end }}
        {{ if gt (len .MitigatedArchives) 0 }}<li><a href="#threat-archive">Archives bloquées</a></li>{{ end }}
        {{ if gt .NbFileNotAnalyzed 0 }}<li><a href="#not-analyzed-files">Fichiers non analysés</a></li>{{ end }}
        {{ if gt (len .ErrorFiles) 0 }}<li><a href="#error-files">Fichiers en erreur</a></li>{{ end }}
    </ol>
</nav>

<section id="summary">
    <h2>Résumé</h2>
    <p class="lead">
        {{ .NbFileSubmitted }} fichiers ont été soumis, dont {{ .NbFileAnalyzed }} analysés.
        {{ if gt .TotalMitigated 0 }}{{ .TotalMitigated }} ont été bloqués, dont {{ .TotalMalware }} identifiés comme malveillants.{{ else }}Aucun n'a été bloqué.{{ end }}
    </p>

    <div class="breakdown" role="img" aria-label="Répartition des fichiers">
        <span class="s-ok" style="flex-grow: {{ .NbFileAnalyzed }}"></span>
        <span class="s-bad" style="flex-grow: {{ .TotalMitigated }}"></span>
        <span class="s-na" style="flex-grow: {{ .NbFileNotAnalyzed }}"></span>
        <span class="s-err" style="flex-grow: {{ .TotalErrors }}"></span>
    </div>
    <ul class="legend">
        <li style="--c: var(--green)">Analysés · {{ .NbFileAnalyzed }}</li>
        <li style="--c: var(--red)">Bloqués · {{ .TotalMitigated }}</li>
        <li style="--c: var(--amber)">Non analysés · {{ .NbFileNotAnalyzed }}</li>
        <li style="--c: var(--grey)">En erreur · {{ .TotalErrors }}</li>
    </ul>

    <table class="facts">
        <tr><th>Taille totale (avant extraction)</th><td>{{ .FileVolume }}</td></tr>
        <tr><th>Volume analysé</th><td>{{ .AnalyzedVolume }}</td></tr>
        <tr><th>Volume filtré</th><td>{{ .FilteredVolume }}</td></tr>
        <tr><th>Fichiers en erreur</th><td>{{ .TotalErrors }}</td></tr>
    </table>

    <blockquote>
        {{ if gt .TotalMitigated 0 }}
        <p>Un ou plusieurs fichiers ont été bloqués par les moteurs d'analyse.</p>
        {{ else }}
        <p>Aucun comportement suspect ou malveillant n'a été détecté dans les fichiers soumis.</p>
        {{ end }}
        <p>Seuls les fichiers analysés comme sains ont été déplacés sur le support de destination.</p>
        {{ if gt .NbFileNotAnalyzed 0 }}
        <p>Des fichiers non analysés ont pu être transmis selon la politique <code>unanalyzable_policy</code> : leur contenu n'a pas été vérifié.</p>
        {{ end }}
    </blockquote>
</section>

{{ if gt (len .MitigatedFiles) 0 }}
<section id="threat-files">
    <h2>Fichiers bloqués</h2>
    <ol class="findings">
        {{ template "extractedFilesRows" (mergeArgsIntoSlice .MitigatedFiles 0) }}
    </ol>
    {{ if gt .MoreMitigatedFiles 0 }}<p class="more">… et {{ others .MoreMitigatedFiles "" "" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt (len .MitigatedArchives) 0 }}
<section id="threat-archive">
    <h2>Archives bloquées</h2>
    {{ range $index, $a := .MitigatedArchives }}
    <div class="archive-card" id="threat-archive-{{ $index }}">
        <h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="#14213d" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4"/></svg>
            {{ .Name }}
        </h3>
        <p class="archive-meta">{{ .FileCount }} sous-fichiers · {{ .Size }} · quarantaine <code>{{ .QuarantineLocation }}</code><br><code>{{ .SHA256 }}</code></p>
        <ol class="findings">
            {{ template "extractedFilesRows" (mergeArgsIntoSlice .ExtractedFiles 0) }}
        </ol>
        {{ if gt .MoreExtracted 0 }}<p class="more">… et {{ others .MoreExtracted " fichier de l'archive" " fichiers de l'archive" }}</p>{{ end }}
    </div>
    {{ end }}
    {{ if gt .MoreMitigatedArchives 0 }}<p class="more">… et {{ others .MoreMitigatedArchives " archive" " archives" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt .NbFileNotAnalyzed 0 }}
<section id="not-analyzed-files">
    <h2>Fichiers non analysés</h2>
    <p>Leur contenu n'a pas été vérifié. Total : {{ .NbFileNotAnalyzed }}.</p>
    <table class="simple">
        <thead><tr><th>Fichier</th><th>Taille</th><th>Raison</th><th>Archive d'origine</th></tr></thead>
        <tbody>
        {{ range .NotAnalyzedFiles }}<tr><td>{{ .Name }}</td><td>{{ .Size }}</td><td>{{ .Reason }}</td><td>{{ .Origin }}</td></tr>{{ end }}
        </tbody>
    </table>
    {{ if gt .MoreNotAnalyzed 0 }}<p class="more">… et {{ others .MoreNotAnalyzed "" "" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt (len .ErrorFiles) 0 }}
<section id="error-files">
    <h2>Fichiers en erreur</h2>
    <table class="simple">
        <thead><tr><th>Fichier</th><th>Erreur</th></tr></thead>
        <tbody>
        {{ range .ErrorFiles }}<tr><td>{{ .Name }}</td><td>{{ .Error }}</td></tr>{{ end }}
        </tbody>
    </table>
    {{ if gt .MoreErrorFiles 0 }}<p class="more">… et {{ others .MoreErrorFiles "" "" }}</p>{{ end }}
</section>
{{ end }}

</body>
</html>
